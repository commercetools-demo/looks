# Looks: variables per project. Copy to mc-looks-app/.env.local for local development.
# Connect injects APPLICATION_URL itself; on Netlify set it as an environment variable.

# --- Deployment (connect.yaml / Netlify) ---
# The Custom Application ID from the Merchant Center registration.
CUSTOM_APPLICATION_ID=
# Entry point URI path of the application (default: looks).
ENTRY_POINT_URI_PATH=looks
# Production URL of the hosted application (Netlify site URL; provided by Connect).
APPLICATION_URL=
# Project key used by the local dev server and type generation.
INITIAL_PROJECT_KEY=
# One of gcp-us, gcp-eu, aws-us, aws-eu.
CLOUD_IDENTIFIER=gcp-eu

# --- Per-project catalog and shop settings (read only by mc-looks-app/src/config.ts) ---
# Attributes that tell the variants of a product apart, comma-separated, in display
# order, for example: searchColor,finishColor,size (default: size).
VARIANT_ATTRIBUTES=size
# Localized colour-name attribute (default: color-name).
COLOR_NAME_ATTRIBUTE=color-name
# Fallback colour attribute, an enum or localized enum (default: color).
COLOR_ATTRIBUTE=color
# Shop origin for look photos and "Im Shop ansehen", for example https://shop.example.com
SHOP_ORIGIN=
